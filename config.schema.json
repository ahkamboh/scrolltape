{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Scrolltape Config",
  "type": "object",
  "required": ["url"],
  "properties": {
    "url": { "type": "string", "format": "uri" },
    "cursor": {
      "type": "string",
      "enum": ["white-pointer", "mac-hand", "cute-paw", "brand-dot"],
      "default": "white-pointer"
    },
    "customCursorSvg": { "type": "string" },
    "heroHoldSec": { "type": "number", "default": 3, "minimum": 0.5, "maximum": 30 },
    "tour": {
      "type": "string",
      "enum": ["standard", "hero-only", "feature-focus", "quick-teaser", "deep-dive", "interactive-hero"],
      "default": "standard"
    },
    "viewport": {
      "oneOf": [
        { "type": "string", "enum": ["landscape", "portrait", "square"] },
        { "type": "object", "properties": { "width": { "type": "integer" }, "height": { "type": "integer" } } }
      ],
      "default": "landscape"
    },
    "scrollSpeed": { "type": "string", "enum": ["slow", "normal", "fast"], "default": "normal" },
    "focusSections": { "type": "array", "items": { "type": "string" } },
    "sectionIds": { "type": "array", "items": { "type": "string" } },
    "heroSelector": { "type": "string", "default": "h1" },
    "outputDir": { "type": "string", "default": "renders" },
    "outputName": { "type": "string" }
  }
}
